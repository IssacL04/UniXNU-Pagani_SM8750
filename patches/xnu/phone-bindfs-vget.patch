+/*
+ * Lookup by file ID (fsgetpath, volfs paths, openbyid_np), after bindfs_vget of UniXNU-sheng (patches/xnu-12377/zzzz-sheng-ipados27-
+ * bringup.patch, BSD-2-Clause-Patent). Why a boot view needs it, read from 21H461: on a volume without PATH_FROM_ID CoreServicesInternal
+ * keeps no file ID (_kCFURLFileIDKey), so -[FSNode initWithURL:flags:error:] with flag 1 returns nil, _LSAddBundlePlugins never parses a
+ * plug-in's executable, the plug-in is registered with platform 0 and finds no extension point, and chronod ignores a widget extension as
+ * restricted. A volume that says PATH_FROM_ID must also answer: bindfs reports the lower file system's file IDs, so get the lower vnode,
+ * take its path relative to the bound root and look that path up from our root. The vnode returned is ours, named and parented under the
+ * mount point, as build_path needs. An ID outside the bound tree is not found (ENOENT: fsgetpath then asks the covered volume, which holds
+ * the other half of a union). Differences from the original: the root's own ID BIND_ROOT_INO resolves; the lower path may enter the file
+ * system (a vnode VFS_VGET just made has no cached parent); the lower root is held while its path is taken; the walk does not cross a
+ * mount and runs with the kernel's context, because VFS_VGET authorizes nothing and fsgetpath_internal applies the caller's policy to
+ * the result (a caller's sandbox would otherwise decide what a file ID resolves to); our root is held across that walk.
+ */
+static int
+bindfs_vget(struct mount * mp, ino64_t ino, struct vnode ** vpp, vfs_context_t ctx)
+{
+	struct bind_mount * bindm = MOUNTTOBINDMOUNT(mp);
+	vnode_t lowerroot;
+	vnode_t lowervp = NULLVP;
+	char * lowerpath = NULL;
+	char * rootpath = NULL;
+	const char * relative = NULL;
+	size_t rootlen;
+	int len, error;
+
+	*vpp = NULLVP;
+	if (bindm == NULL || !(bindm->bindm_flags & BINDM_PATH_FROM_ID)) {
+		return ENOTSUP;
+	}
+	os_atomic_inc(&native_bindfs_vget_calls, relaxed);
+	lowerroot = bindm->bindm_lowerrootvp;
+	if (ino == BIND_ROOT_INO) {
+		error = bindfs_root(mp, vpp, ctx);
+		goto done;
+	}
+	error = vnode_getwithref(lowerroot);
+	if (error) {
+		goto done;
+	}
+	error = VFS_VGET(vnode_mount(lowerroot), ino, &lowervp, ctx);
+	if (error) {
+		vnode_put(lowerroot);
+		goto done;
+	}
+	if (lowervp == lowerroot) {
+		vnode_put(lowervp);
+		vnode_put(lowerroot);
+		error = bindfs_root(mp, vpp, ctx);
+		goto done;
+	}
+	lowerpath = zalloc(ZV_NAMEI);
+	rootpath = zalloc(ZV_NAMEI);
+	len = MAXPATHLEN;
+	error = vn_getpath_fsenter(lowervp, lowerpath, &len);
+	vnode_put(lowervp);
+	if (error == 0) {
+		len = MAXPATHLEN;
+		error = vn_getpath_fsenter(lowerroot, rootpath, &len);
+	}
+	vnode_put(lowerroot);
+	if (error == 0) {
+		rootlen = strlen(rootpath);
+		if (rootlen == 1 && rootpath[0] == '/') {
+			relative = lowerpath + 1;
+		} else if (strncmp(lowerpath, rootpath, rootlen) == 0 && lowerpath[rootlen] == '/') {
+			relative = lowerpath + rootlen + 1;
+		}
+		if (relative && *relative) {
+			error = vnode_getwithref(bindm->bindm_rootvp);
+			if (error == 0) {
+				error = vnode_lookupat(relative, VNODE_LOOKUP_NOFOLLOW | VNODE_LOOKUP_NOCROSSMOUNT, vpp, vfs_context_kernel(), bindm->bindm_rootvp);
+				vnode_put(bindm->bindm_rootvp);
+			}
+		} else {
+			error = ENOENT;
+		}
+	}
+	zfree(ZV_NAMEI, lowerpath);
+	zfree(ZV_NAMEI, rootpath);
+done:
+	if (error == 0) {
+		os_atomic_inc(&native_bindfs_vget_resolved, relaxed);
+	}
+	return error;
+}
