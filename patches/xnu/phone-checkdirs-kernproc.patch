diff --git a/bsd/vfs/vfs_syscalls.c b/bsd/vfs/vfs_syscalls.c
--- a/bsd/vfs/vfs_syscalls.c
+++ b/bsd/vfs/vfs_syscalls.c
@@ -2518,6 +2518,24 @@ checkdirs_callback(proc_t p, void * arg)
 	}
 	proc_fdunlock(p);
 
+	/*
+	 * phone-checkdirs-kernproc.patch. kernproc's current directory holds no usecount of its own: set_rootvnode() only assigns it, it
+	 * shares the one reference of rootvnode, and checkdirs() moves that reference to newdp below. Follow the pointer and leave the
+	 * counts alone: the release below would take a reference another holder of the covered root still has to drop. The last of them,
+	 * private-dir's v_parent reference, then goes when apfs_vfsop_unmount's last vflush reclaims it and finds the reclaimed root at 0:
+	 * the panic in _vnode_rele_internal at usecount -1, once SystemOS is mounted over "/".
+	 */
+	if (p == kernproc && olddp == rootvnode) {
+		proc_dirs_lock_exclusive(p);
+		proc_fdlock(p);
+		if (fdp->fd_cdir == olddp) {
+			fdp->fd_cdir = newdp;
+		}
+		proc_fdunlock(p);
+		proc_dirs_unlock_exclusive(p);
+		return PROC_RETURNED;
+	}
+
 	/*
 	 * Ok, we will have to do some work.  Always take two refs
 	 * because we might need that many.  We'll dispose of whatever
