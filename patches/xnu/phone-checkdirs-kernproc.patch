diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -7656,6 +7656,17 @@ native_owner_cache_prepare(proc_t p, user_addr_t scratch, user_addr_t *envp)
 	boot_progress_root("SystemOS mount syscall returned", NULL, (unsigned)error);
 	native_owner_cache_mount_status = error;
 	if (error) goto done;
+	/* phone-checkdirs-kernproc.patch. Before launchd runs (its directory descriptors move these counts). Every APFS root starts at 5:
+	 * the volume's own reference and the v_parent references of private-dir, .snaps and the two xattr vnodes (every vnode holds one on
+	 * its parent). The covered root adds the covering mount's and its children looked up so far, /dev and /private (the swap file's
+	 * path): 8. The new root adds rootvnode's, which kernproc's current directory shares, and pid 1's current directory: 7. A checkdirs
+	 * that took kernproc's reference it never had gives 7 and 8. The addresses compare with a vnode panic's. */
+	{
+		char roots[96];
+		snprintf(roots, sizeof(roots), "old %llx use %d, root %llx use %d", (unsigned long long)(uintptr_t)original_os_root,
+		    original_os_root->v_usecount, (unsigned long long)(uintptr_t)rootvnode, rootvnode->v_usecount);
+		boot_progress_root("SystemOS root refs", roots, 0);
+	}
 	native_owner_cache_stage = 4;
 	boot_progress_root("SystemOS vnode lookup enter", mountpoint, 0);
 	error = vnode_lookup(mountpoint, 0, &mounted_root, vfs_context_current());
@@ -7681,6 +7692,12 @@ native_owner_cache_prepare(proc_t p, user_addr_t scratch, user_addr_t *envp)
 #endif
 	boot_progress_root("SystemOS mounted auth returned", NULL, cache_authorized);
 	if (!cache_authorized) { error = EAUTH; goto done; }
+#if defined(XNU_OWNER_UNION_SYSTEMOS) && XNU_OWNER_UNION_SYSTEMOS
+	/* phone-checkdirs-kernproc.patch. This volume carries the shared cache launchd runs from. The first vfs_unmountall of a shutdown
+	 * force-unmounts all but the root and the system volumes while launchd still runs: a thread of it faulting on a cache page then
+	 * gets a memory error and panics the kernel ("initproc exited"). A system volume waits for the second, launchd suspended. */
+	vfs_setmntsystem(cache_mount);
+#endif
 	native_owner_cache_stage = 5;
 #if !defined(XNU_OWNER_UNION_SYSTEMOS) || !XNU_OWNER_UNION_SYSTEMOS
