+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef XNU_EARLY_BOOT_PROGRESS_H
+#define XNU_EARLY_BOOT_PROGRESS_H
+#include <stdint.h>
+#if defined(XNU_EARLY_BOOT_PROGRESS) && XNU_EARLY_BOOT_PROGRESS
+struct boot_args;
+void early_boot_progress_init(struct boot_args *);
+int early_boot_progress_map(uint64_t *, uintptr_t, uintptr_t);
+void early_boot_progress_mmu_on(void);
+void early_boot_progress_arm_init(void);
+void early_boot_progress_suspend(void);
+void early_boot_progress_vm_ready(void);
+void early_boot_progress_fatal(struct boot_args *, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t);
+void boot_progress_kernel_exception(uint64_t, uint64_t, uint64_t);
+#else
+#define early_boot_progress_arm_init() ((void)0)
+#define early_boot_progress_suspend() ((void)0)
+#define early_boot_progress_vm_ready() ((void)0)
+#define boot_progress_kernel_exception(...) ((void)0)
+#endif
+#endif
