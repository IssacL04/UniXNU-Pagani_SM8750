+/* thread_dispatch, at splsched with self locked: nothing here takes a lock or follows more than the task and proc pointers of the running thread. */
+void
+pagani_stall_dispatch(thread_t self, processor_t processor, uint64_t latency)
+{
+	struct boot_progress_stall_run run;
+
+	run.stamp = processor->last_dispatch;
+	run.latency = latency;
+	run.tid = self->thread_id;
+	run.name = NULL;
+	run.pid = 0;
+	run.pri = self->sched_pri;
+	run.cpu = (uint32_t)processor->cpu_id;
+	run.user = 0;
+	if (self->state & TH_IDLE) {
+		run.pid = -1;
+	} else {
+		task_t task = get_threadtask(self);
+		if (task != kernel_task) {
+			struct proc *p = get_bsdtask_info(task);
+			run.pid = task_pid(task);
+			run.user = 1;
+			if (p != NULL) {
+				run.name = proc_best_name(p);
+			}
+		}
+	}
+	boot_progress_stall_run(&run);
+}
+
+static void
+stall_regs_copy(struct boot_progress_stall_regs *out, struct arm_saved_state *state)
+{
+	out->valid = 0;
+	out->kernel = 0;
+	out->kpc = 0;
+	if (state == NULL || !is_saved_state64(state)) {
+		return;
+	}
+	out->pc = (uint64_t)get_saved_state_pc(state);
+	out->lr = (uint64_t)get_saved_state_lr(state);
+	out->fp = (uint64_t)get_saved_state_fp(state);
+	out->sp = (uint64_t)get_saved_state_sp(state);
+	out->far = (uint64_t)get_saved_state_far(state);
+	out->esr = get_saved_state_esr(state);
+	out->cpsr = get_saved_state_cpsr(state);
+	for (int i = 0; i < 8; i++) {
+		out->x[i] = (uint64_t)get_saved_state_reg(state, i);
+	}
+	out->x16 = (uint64_t)get_saved_state_reg(state, 16);
+	out->valid = 1;
+}
+
+/*
+ * The return addresses of a thread off core, past thread_invoke and the block routine above it, inside its kernel stack. Under the thread lock:
+ * it cannot be dispatched meanwhile, so the stack stays. Its registers may be a moment old while it is still switching away; then the walk reads
+ * stale words of the stack, and it never leaves the stack.
+ */
+static void
+stall_kernel_frames(thread_t thread, struct boot_progress_stall_thread *out)
+{
+	const uintptr_t low = thread->kernel_stack, high = low + kernel_stack_size;
+	uint64_t fp, lr;
+	unsigned skip = 2;
+
+	if (thread->machine.kpcb != NULL) {
+		fp = thread->machine.kpcb->ss_64.fp;
+		lr = thread->machine.kpcb->ss_64.lr;
+		skip = 0;                       /* preempted: its own frames start right there */
+	} else {
+		arm_kernel_saved_state_t *kstate = &thread_get_kernel_state(thread)->machine.ss;
+		fp = kstate->fp;
+		lr = kstate->lr;
+	}
+	while (out->kframes < 5) {
+		if (skip) {
+			skip--;
+		} else {
+			out->kframe[out->kframes++] = VM_KERNEL_UNSLIDE(lr);
+		}
+		if ((fp & 7) || fp < low || fp + 16 > high) {
+			break;
+		}
+		const uint64_t next = ((const uint64_t *)fp)[0];
+		lr = ((const uint64_t *)fp)[1];
+		if (next <= fp) {
+			break;
+		}
+		fp = next;
+	}
+}
+
+/* Thread context, no lock held, with a reference on the thread. 1, and *out; 0 without a thread. */
+int
+boot_progress_stall_thread_read(void *handle, struct boot_progress_stall_thread *out)
+{
+	thread_t thread = handle;
+
+	if (thread == THREAD_NULL) {
+		return 0;
+	}
+	spl_t s = splsched();
+	thread_lock(thread);
+	const processor_t last = thread->last_processor;
+	const bool on_core = (thread->state & TH_RUN) && thread_get_runq(thread) == PROCESSOR_NULL && last != PROCESSOR_NULL &&
+	    last->active_thread == thread;
+	out->tid = thread->thread_id;
+	out->wait_event = (uint64_t)VM_KERNEL_UNSLIDE_OR_PERM(thread->wait_event);
+	out->last_run = thread->last_run_time;
+	out->made_runnable = thread->last_made_runnable_time;
+	out->continuation = (uint64_t)VM_KERNEL_UNSLIDE(thread->continuation);
+	out->kframes = 0;
+	out->state = (uint32_t)thread->state;
+	out->hint = (uint32_t)thread->block_hint;
+	out->active = thread->active;
+	out->sched_pri = thread->sched_pri;
+	out->base_pri = thread->base_pri;
+	out->cpu = on_core ? last->cpu_id : -1;
+	out->reserved = 0;
+	if (!on_core && thread->continuation == NULL && thread->kernel_stack != 0) {
+		stall_kernel_frames(thread, out);
+	}
+	thread_unlock(thread);
+	splx(s);
+	/* The PCB: stable while the thread is in the kernel, and a stale but harmless read while it runs in user space (the caller asks its CPU then). */
+	stall_regs_copy(&out->user, get_user_regs(thread));
+	return 1;
+}
+
+/* A cross-call's handler, on a CPU in its IPI handler: 1 when `handle` is the thread it interrupted, with that thread's user state. */
+int
+boot_progress_stall_regs_here(void *handle, struct boot_progress_stall_regs *out)
+{
+	thread_t thread = handle;
+	struct arm_saved_state *state = getCpuDatap()->cpu_int_state;
+
+	if (current_thread() != thread || state == NULL) {
+		return 0;
+	}
+	if (PSR64_IS_USER(get_saved_state_cpsr(state))) {
+		stall_regs_copy(out, state);
+	} else {
+		stall_regs_copy(out, get_user_regs(thread));
+		out->kernel = 1;
+		out->kpc = (uint64_t)VM_KERNEL_UNSLIDE(get_saved_state_pc(state));
+	}
+	return 1;
+}
+
+/* SIGPxcallImm: fails at once when one is pending or the CPU is off, never waits. 0 when it went out. */
+int
+boot_progress_stall_xcall(unsigned cpu, void (*function)(void *), void *parameter)
+{
+	if (cpu >= MAX_CPUS || cpu_datap((int)cpu) == NULL) {
+		return -1;
+	}
+	return cpu_immediate_xcall((int)cpu, function, parameter) == KERN_SUCCESS ? 0 : -1;
+}
+
+/*
+ * A task by process name, or by pid when name is NULL, with a reference, and what naming its addresses takes. Thread context; a try-lock: a list
+ * in use costs one sample (out->pid -1), a sampler never queues behind a burst of forks.
+ */
+void *
+boot_progress_stall_task_find(const char *name, int32_t pid, struct boot_progress_stall_task *out)
+{
+	task_t task, found = TASK_NULL;
+
+	/* Past the lock a process that finishes exiting has no proc any more: what comes from it is copied under the lock. */
+	out->pid = -1;
+	if (!lck_mtx_try_lock(&tasks_threads_lock)) {
+		return NULL;
+	}
+	out->pid = 0;
+	queue_iterate(&tasks, task, task_t, tasks) {
+		struct proc *p = get_bsdtask_info(task);
+		if (p == NULL || !task->active) {
+			continue;
+		}
+		if (name != NULL ? strcmp(proc_best_name(p), name) == 0 : task_pid(task) == pid) {
+			task_reference(task);
+			found = task;
+			out->pid = task_pid(task);
+			strlcpy(out->name, proc_best_name(p), sizeof(out->name));
+			break;
+		}
+	}
+	lck_mtx_unlock(&tasks_threads_lock);
+	if (found == TASK_NULL) {
+		return NULL;
+	}
+	out->cache_start = out->cache_end = out->cache_slide = 0;
+	out->main_header = found->mach_header_vm_address;
+	out->user_limit = 0;
+	vm_map_t map = get_task_map_reference(found);
+	if (map != VM_MAP_NULL) {
+		out->user_limit = (uint64_t)vm_map_max(map);
+		vm_map_deallocate(map);
+	}
+	vm_shared_region_t shared_region = vm_shared_region_get(found);
+	if (shared_region != NULL) {
+		if (shared_region->sr_first_mapping != (mach_vm_offset_t)-1) {
+			out->cache_start = shared_region->sr_base_address;
+			out->cache_end = shared_region->sr_base_address + shared_region->sr_size;
+			out->cache_slide = shared_region->sr_slide;
+		}
+		vm_shared_region_deallocate(shared_region);
+	}
+	return found;
+}
+
+void
+boot_progress_stall_task_release(void *handle)
+{
+	task_deallocate((task_t)handle);
+}
+
+/*
+ * The App on screen: the newest task in the focal role but the two named, and in *count how many there are. RunningBoard gives that role to what it
+ * calls UI focal (setpriority(PRIO_DARWIN_ROLE, PRIO_DARWIN_ROLE_UI_FOCAL), proc_darwin_role_to_task_role), a word of the task read without a lock.
+ * The pid and no reference: only a new App costs the lookup above. 0 nobody, -1 the list was in use. The same try-lock, once for each gap sample.
+ */
+int32_t
+boot_progress_stall_foreground(const char *not_a, const char *not_b, uint32_t *count)
+{
+	task_t task;
+	int32_t pid = 0;
+
+	*count = 0;
+	if (!lck_mtx_try_lock(&tasks_threads_lock)) {
+		return -1;
+	}
+	queue_iterate(&tasks, task, task_t, tasks) {
+		struct proc *p = get_bsdtask_info(task);
+		if (p == NULL || !task->active || proc_get_effective_task_policy(task, TASK_POLICY_ROLE) != TASK_FOREGROUND_APPLICATION) {
+			continue;
+		}
+		const char *name = proc_best_name(p);
+		if (strcmp(name, not_a) == 0 || strcmp(name, not_b) == 0) {
+			continue;
+		}
+		pid = task_pid(task);
+		(*count)++;
+	}
+	lck_mtx_unlock(&tasks_threads_lock);
+	return pid;
+}
+
+/* A live thread of the task with a reference: by id, by a piece of its pthread name, or the first one, the main thread. NULL also when the task is locked. */
+void *
+boot_progress_stall_thread_find(void *handle, const char *name, uint64_t tid)
+{
+	task_t task = handle;
+	thread_t thread, found = THREAD_NULL;
+
+	if (!task_lock_try(task)) {
+		return NULL;
+	}
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		if (!thread->active) {
+			continue;
+		}
+		if (tid != 0) {
+			if (thread->thread_id != tid) {
+				continue;
+			}
+		} else if (name != NULL) {
+			char text[MAXTHREADNAMESIZE];
+			text[0] = '\0';
+			bsd_getthreadname(get_bsdthread_info(thread), text);
+			text[MAXTHREADNAMESIZE - 1] = '\0';
+			if (strnstr(text, name, sizeof(text)) == NULL) {
+				continue;
+			}
+		}
+		thread_reference(thread);
+		found = thread;
+		break;
+	}
+	task_unlock(task);
+	return found;
+}
+
+void
+boot_progress_stall_thread_release(void *handle)
+{
+	thread_deallocate((thread_t)handle);
+}
+
+/* The task's live threads and their CPU time. max + 1 when the task is locked: 0 is a task without threads, and the caller lets that one go. */
+unsigned
+boot_progress_stall_thread_times(void *handle, uint64_t *tids, uint64_t *times, unsigned max)
+{
+	task_t task = handle;
+	thread_t thread;
+	unsigned n = 0;
+
+	if (!task_lock_try(task)) {
+		return max + 1;
+	}
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		if (n == max) {
+			break;
+		}
+		if (thread->active) {
+			tids[n] = thread->thread_id;
+			times[n] = recount_thread_time_mach(thread);
+			n++;
+		}
+	}
+	task_unlock(task);
+	return n;
+}
+
+/* The task's map with a reference: holds the pmap the reads below use, also across an exec. */
+void *
+boot_progress_stall_map(void *handle)
+{
+	return get_task_map_reference((task_t)handle);
+}
+
+void
+boot_progress_stall_map_release(void *handle)
+{
+	vm_map_deallocate((vm_map_t)handle);
+}
+
+/*
+ * Aligned 64-bit words of user memory that is resident and managed, through the pmap's short lock and ml_phys_read: no fault, no sleep, no
+ * vm_map lock, so a stalled thread's own fault or map lock cannot hold the sampler. 0 when all of it was read. A page freed right after the lookup
+ * gives wrong words, never a fault; the walk's checks stop at them.
+ */
+int
+boot_progress_stall_map_read(void *handle, uint64_t address, void *buffer, uint32_t bytes)
+{
+	const pmap_t pmap = vm_map_pmap((vm_map_t)handle);
+	uint64_t *to = buffer;
+
+	if ((address & 7) || (bytes & 7)) {
+		return -1;
+	}
+	for (; bytes; bytes -= 8, address += 8) {
+		const ppnum_t ppn = pmap_find_phys(pmap, address);
+		const pmap_paddr_t pa = ptoa(ppn);
+		if (ppn == 0 || !pmap_valid_address(pa)) {
+			return -1;
+		}
+		*to++ = ml_phys_read_double_64(pa | (address & PAGE_MASK));
+	}
+	return 0;
+}
+
+/* May block on the map and vnode locks: the low-priority thread call only. 1 when a file mapping holds the address. */
+int
+boot_progress_stall_image(void *handle, uint64_t address, struct boot_progress_crash_image *image)
+{
+	return crash_trace_image(handle, address, image);
+}
+
+/* No lock: racy words, the sampler judges two ticks in a row. A runq count is two loads through the scheduler's table. */
+void
+boot_progress_stall_cpu_read(unsigned cpu, struct boot_progress_stall_cpu *out)
+{
+	processor_t processor = cpu < MAX_SCHED_CPUS ? processor_array[cpu] : PROCESSOR_NULL;
+
+	out->kind = STALL_CPU_OFF;
+	out->on_idle = 0;
+	out->runq = 0;
+	out->rt = 0;
+	if (processor == PROCESSOR_NULL) {
+		return;
+	}
+	switch (processor->state) {
+	case PROCESSOR_IDLE:
+		out->kind = STALL_CPU_IDLE;
+		break;
+	case PROCESSOR_DISPATCHING:
+		out->kind = STALL_CPU_DISPATCHING;
+		break;
+	case PROCESSOR_RUNNING:
+		out->kind = STALL_CPU_RUNNING;
+		break;
+	default:
+		return;
+	}
+	out->on_idle = processor->active_thread == processor->idle_thread;
+	out->runq = SCHED(processor_runq_count)(processor);
+	out->rt = rt_runq_count(processor->processor_set);
+}
+
+void
+boot_progress_stall_vm_read(struct boot_progress_stall_vm *out)
+{
+	out->faults = counter_load(&vm_statistics_faults);
+	out->pageins = counter_load(&vm_statistics_pageins);
+	out->compressions = counter_load(&vm_statistics_compressions);
+	out->decompressions = counter_load(&vm_statistics_decompressions);
+	for (int tier = 0; tier < 4; tier++) {
+		out->throttled[tier] = (uint32_t)throttled_count[tier];
+	}
+	out->page_waits = pagani_vm_page_waits;
+}
+
+/* The memory account: plain loads of words that change all the time, a picture of the moment (M mem, every few seconds). */
+void
+boot_progress_stall_mem_read(struct boot_progress_stall_mem *out)
+{
+	out->wired = vm_page_wire_count;
+	out->internal = vm_page_pageable_internal_count;
+	out->external = vm_page_pageable_external_count;
