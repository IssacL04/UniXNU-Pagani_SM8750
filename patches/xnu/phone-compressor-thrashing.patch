 #else /* !XNU_TARGET_OS_OSX */
 #define COMPRESSOR_FREE_RESERVED_LIMIT          128
 #endif /* !XNU_TARGET_OS_OSX */
+
+/*
+ * Both thrashing detectors compare page counts per period, with values tuned
+ * on 16 KiB pages: decompressions (compute_swapout_target_age) and pages read
+ * back soon after their eviction (vm_phantom_cache_check_pressure). What they
+ * stand for is bytes per second, the data decompressed or read twice, and a
+ * 4 KiB kernel counts four pages for the same data. Scaled, they trip at the
+ * rate they trip at on a 16 KiB device (78 and 62 MiB/s, not 19 and 15), and
+ * a jetsam for thrashing means the same thing. Neither sees a page without an
+ * active compressor: the phantom cache is not even set up then.
+ */
+#define VM_THRASHING_PAGES(pages_16k)           ((pages_16k) * (16384 / ARM_PGBYTES))
 
 uint32_t vm_compressor_get_encode_scratch_size(void) __pure2;
 uint32_t vm_compressor_get_decode_scratch_size(void) __pure2;
