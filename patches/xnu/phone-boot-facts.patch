+		for (int i = 0; i < HEX_PER_LINE / 2 && at < length; i++, at++) {
+			line[used++] = digits[bytes[at] >> 4];
+			line[used++] = digits[bytes[at] & 15];
+		}
+		line[used] = 0;
+		boot_progress_trace(line);
+	}
+	if (bytes) {
+		kfree_data(bytes, STATE_MAX);
+	}
