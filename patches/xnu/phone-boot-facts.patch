+		from = (const char *)arg0;
+		to = (const char *)arg1;
+	} else if (action == KAUTH_FILEOP_DELETE) {
+		from = (const char *)arg1;
+	} else {
+		return KAUTH_RESULT_DEFER;
+	}
+	if (!native_staged_apps_bundle(from) && !native_staged_apps_bundle(to)) {
