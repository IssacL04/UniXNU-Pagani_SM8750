+static char
+native_staged_apps_place(const char *path)
+{
+	if (!path) {
+		return '-';
+	}
+	if (!strncmp(path, "/private/var/staged_system_apps/", 32)) {
+		return 'S';
+	}
+	if (strnstr(path, "/containers/Bundle/Application/", MAXPATHLEN)) {
+		return 'B';
+	}
+	if (strnstr(path, "installcoordinationd", MAXPATHLEN)) {
+		return 'C';
+	}
+	if (strnstr(path, "/installd/", MAXPATHLEN)) {
+		return 'I';
+	}
+	if (strnstr(path, "/tmp/", MAXPATHLEN) || strnstr(path, "/Caches/", MAXPATHLEN)) {
+		return 'T';
+	}
+	return 'O';
+}
+static bool
+native_staged_apps_bundle(const char *path)
+{
+	size_t length = path ? strlen(path) : 0;
+	return length > 4 && !strcmp(path + length - 4, ".app");
+}
+/* The tail of PATH that fits in SIZE - 1 characters. */
+static const char *
+native_staged_apps_tail(const char *path, size_t size)
+{
+	size_t length = path ? strlen(path) : 0;
+	return !path ? "-" : length > size - 1 ? path + length - (size - 1) : path;
+}
+static int
+native_staged_apps_fileop(__unused kauth_cred_t credential, __unused void *idata, kauth_action_t action, uintptr_t arg0, uintptr_t arg1,
+    __unused uintptr_t arg2, __unused uintptr_t arg3)
+{
+	const char *from = NULL, *to = NULL;
