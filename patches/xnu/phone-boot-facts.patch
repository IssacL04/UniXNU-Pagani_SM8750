+		struct native_staged_apps_move *move = &native_staged_apps_moves[i];
+		if (!move->count) {
+			move->op = op;
+			move->from = from_place;
+			move->to = to_place;
+			strlcpy(move->process, process, sizeof(move->process));
+			slot = move;
+		} else if (move->op == op && move->from == from_place && move->to == to_place &&
+		    !strncmp(move->process, process, sizeof(move->process) - 1)) {
+			slot = move;
+		}
+	}
+	if (slot) {
+		slot->count++;
+	} else {
