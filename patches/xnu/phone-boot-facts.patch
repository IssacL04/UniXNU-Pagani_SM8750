+		boot_progress_trace(line);
+	}
+	return KAUTH_RESULT_DEFER;
+}
+/* The counts above as one line ("app moves: R S>C installcoordinati 29, ..., lost 0"). */
+static void __attribute__((noinline))
+native_staged_apps_moves_line(void)
+{
+	char line[400];
+	size_t used = strlcpy(line, "app moves:", sizeof(line));
+	lck_mtx_lock(&native_staged_apps_lock);
+	for (unsigned i = 0; i < NATIVE_STAGED_APPS_MOVES && native_staged_apps_moves[i].count && used < sizeof(line); i++) {
+		const struct native_staged_apps_move *move = &native_staged_apps_moves[i];
+		used += snprintf(line + used, sizeof(line) - used, " %c %c>%c %s %u,", move->op, move->from, move->to, move->process, move->count);
+	}
+	if (used < sizeof(line)) {
+		snprintf(line + used, sizeof(line) - used, " lost %u", native_staged_apps_moves_lost);
+	}
+	lck_mtx_unlock(&native_staged_apps_lock);
+	boot_progress_trace(line);
+}
