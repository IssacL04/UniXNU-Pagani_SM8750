+/* Summaries (and lat lines) of the processes whose counts (timed pairs) changed since their last ones; runs
+ * PAGANI_KBT_FLUSH_MS after the first unreported event. Lines are built under the lock and logged after it. */
 static void
+pagani_kbtrace_flush(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	os_atomic_store(&pagani_kbt_pending, 0, relaxed);
+	for (unsigned i = 0; i < PAGANI_KBT_SLOTS; i++) {
+		char line[PAGANI_KBT_LINE];
+		lck_spin_lock_grp(&pagani_kbt_lock, &kdebug_lck_grp);
+		int have = pagani_kbt_take_dirty(&pagani_kbt, i, line, sizeof(line));
+		lck_spin_unlock(&pagani_kbt_lock);
+		if (have && boot_progress_trace) {
+			boot_progress_trace(line);
+		}
+		lck_spin_lock_grp(&pagani_kbt_lock, &kdebug_lck_grp);
+		have = pagani_kbt_take_lat(&pagani_kbt, i, line, sizeof(line));
+		lck_spin_unlock(&pagani_kbt_lock);
+		if (have && boot_progress_trace) {
+			boot_progress_trace(line);
+		}
+	}
+}
+
+static void
+pagani_kbtrace_note(struct proc *p, uint32_t code, uint64_t arg1, uint64_t arg2)
+{
+	int kind = pagani_kbt_kind(code, arg1);
+	if (kind < 0 || p == NULL) {
+		return;
+	}
+	uint64_t now = mach_absolute_time(), ns = 0;
+	absolutetime_to_nanoseconds(now, &ns);
+	char line[PAGANI_KBT_LINE];
+	lck_spin_lock_grp(&pagani_kbt_lock, &kdebug_lck_grp);
+	int announce = pagani_kbt_count(&pagani_kbt, proc_pid(p), proc_best_name(p), kind, arg2, ns / NSEC_PER_USEC, line,
+	    sizeof(line));
+	lck_spin_unlock(&pagani_kbt_lock);
+	if (announce && boot_progress_trace) {
+		boot_progress_trace(line);
+	}
+	if (os_atomic_load(&pagani_kbt_call_state, acquire) != 2) {
+		if (!os_atomic_cmpxchg(&pagani_kbt_call_state, 0, 1, acquire)) {
+			return;         /* another thread is setting the call up and schedules the summary */
+		}
+		thread_call_t call = thread_call_allocate(pagani_kbtrace_flush, NULL);
+		if (call == NULL) {
+			os_atomic_store(&pagani_kbt_call_state, 0, release);         /* the next point tries again */
+			return;
+		}
+		pagani_kbt_call = call;
+		os_atomic_store(&pagani_kbt_call_state, 2, release);
+	}
+	if (os_atomic_cmpxchg(&pagani_kbt_pending, 0, 1, relaxed)) {
+		uint64_t interval = 0;
+		nanoseconds_to_absolutetime((uint64_t)PAGANI_KBT_FLUSH_MS * NSEC_PER_MSEC, &interval);
+		thread_call_enter_delayed(pagani_kbt_call, now + interval);
+	}
+}
