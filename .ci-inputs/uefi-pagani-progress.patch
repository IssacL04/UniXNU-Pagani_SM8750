+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#include <Uefi.h>
+#include <Library/IoLib.h>
+#include <Library/UefiLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <GpuProbe.h>
+
+STATIC int
+ReadRegister (VOID *Context, CONST char *Name, uint32_t Address, uint32_t *Value)
+{
+  (VOID)Context;
+  // shortcut: bus faults cannot be recovered here; add guarded access before unattended probing.
+  // Keep the pending address visible if access raises an external abort.
+  Print (L"%-14a %08x: reading", Name, Address);
+  *Value = MmioRead32 (Address);
+  Print (L"\r%-14a %08x: %08x\r\n", Name, Address, *Value);
+  return 0;
+}
+
+EFI_STATUS EFIAPI
+GpuProbeEntry (EFI_HANDLE ImageHandle, EFI_SYSTEM_TABLE *SystemTable)
+{
+  struct sm8750_gpu_snapshot  Snapshot;
+  enum sm8750_gpu_probe_result Result;
+  EFI_INPUT_KEY              Key;
+  EFI_STATUS                 Status;
+  UINTN                      EventIndex;
+
+  if ((gST->ConOut == NULL) || (gST->ConIn == NULL)) {
+    return EFI_UNSUPPORTED;
+  }
+
+  gST->ConOut->ClearScreen (gST->ConOut);
+  Print (L"OnePlus 13T / A830 preboot probe v1\r\n");
+  Print (L"Read-only GPUCC; conditional SMMU IDs. No GPU startup.\r\n\r\n");
+  Result = sm8750_gpu_probe (ReadRegister, NULL, &Snapshot);
+  Print (L"\r\nResult=%u CC=%u SMMU=%u\r\n", Result, Snapshot.cc_count, Snapshot.smmu_count);
+  if (Result == GPU_PROBE_SMMU_SKIPPED) {
+    Print (L"SMMU skipped: CX power/reset or clock prerequisites absent.\r\n");
+  } else if (Result == GPU_PROBE_OK) {
+    Print (L"SMMU registers captured; GPU execution remains untested.\r\n");
+  } else {
+    Print (L"Probe stopped: invalid ID or failed register access.\r\n");
+  }
+  Print (L"Photograph this screen. Press a volume key to return.\r\n");
+  // Drain the selection key before waiting for a new physical key press.
+  while (!EFI_ERROR (gST->ConIn->ReadKeyStroke (gST->ConIn, &Key))) { }
+  do {
+    Status = gBS->WaitForEvent (1, &gST->ConIn->WaitForKey, &EventIndex);
+    if (EFI_ERROR (Status)) { return Status; }
+  } while (EFI_ERROR (gST->ConIn->ReadKeyStroke (gST->ConIn, &Key)));
+  return EFI_SUCCESS;
+}
