#!/usr/bin/env python3
"""Build this board in a patched cache; leave the upstream checkout unchanged."""
import hashlib
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

DEVICE = Path(__file__).resolve().parent
UPSTREAM = 'https://github.com/UniXNU/UniXNU.git'


def prepare(device=DEVICE, source=None):
    revision = (device / 'upstream.rev').read_text().strip()
    if not re.fullmatch('[0-9a-f]{40}', revision):
        raise ValueError('upstream.rev must contain a full Git commit ID')
    patch = device / 'patches/unixnu-source-kernel.patch'
    fingerprint = hashlib.sha256(patch.read_bytes()).hexdigest()
    cache = device / '.cache'
    target = cache / f'upstream-{revision[:12]}-{fingerprint[:12]}'
    if target.is_dir():
        return target
    source = source or device.parent / 'UniXNU'
    local = (source / '.git').exists()
    cache.mkdir(parents=True, exist_ok=True)

    def git(*args, cwd=None):
        subprocess.run(['git', *map(str, args)], cwd=cwd, check=True, stdout=sys.stderr)

    with tempfile.TemporaryDirectory(prefix='prepare-', dir=cache) as temporary:
        tree = Path(temporary) / 'tree'
        git('clone', '--no-checkout', '--no-hardlinks', source if local else UPSTREAM, tree)
        found = subprocess.run(['git', 'cat-file', '-e', revision + '^{commit}'], cwd=tree,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if found.returncode:
            git('fetch', UPSTREAM, revision, cwd=tree)
        git('checkout', '--detach', revision, cwd=tree)
        if (tree / '.gitmodules').is_file():
            entries = subprocess.check_output(
                ['git', 'config', '-f', '.gitmodules', '--get-regexp', r'submodule\..*\.path'],
                cwd=tree, text=True)
            for entry in entries.splitlines():
                key, path = entry.split(maxsplit=1)
                if local and (source / path / '.git').exists():
                    git('config', key.removesuffix('.path') + '.url', source / path, cwd=tree)
            git('-c', 'protocol.file.allow=always', 'submodule', 'update', '--init', '--recursive', cwd=tree)
        git('apply', '--check', patch, cwd=tree)
        git('apply', patch, cwd=tree)
        tree.rename(target)
    return target


def main():
    tree = prepare()
    if sys.argv[1:] == ['--prepare']:
        print(tree)
        return
    os.environ.setdefault('UNIXNU_DEVICE', str(DEVICE))
    os.environ.setdefault('UNIXNU_OUT', str(DEVICE / 'out'))
    uefi = DEVICE.parent / 'UEFI-Pagani_SM8750'
    if uefi.is_dir():
        output = DEVICE / 'out/oneplus13t/uefi-build'
        if not os.path.lexists(uefi / 'Build'):
            output.mkdir(parents=True, exist_ok=True)
            (uefi / 'Build').symlink_to(os.path.relpath(output, uefi), target_is_directory=True)
        os.environ.setdefault('UNIXNU_UEFI', str(uefi))
        os.environ.setdefault('UNIXNU_EDK2', str(uefi / 'Mu_Basecore'))
    os.execv(sys.executable, [sys.executable, str(tree / 'unixnu'), *sys.argv[1:]])


if __name__ == '__main__':
    main()
